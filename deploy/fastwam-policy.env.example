# Loopback is the safe default. Expose through an authenticated tunnel or trusted network only.
FASTWAM_POLICY_BIND=127.0.0.1
FASTWAM_POLICY_PORT=8080
FASTWAM_POLICY_DEVICE=cuda

# Every path is mandatory and validated before the listening socket is created.
FASTWAM_POLICY_CHECKPOINT=/srv/fastwam/action-student.pt
FASTWAM_POLICY_DEPLOYMENT_MANIFEST=/srv/fastwam/action-student.deployment.json
FASTWAM_POLICY_STATS=/srv/fastwam/dataset_stats.json
FASTWAM_POLICY_SCHEMA=/srv/fastwam/panthera-schema.json
FASTWAM_POLICY_TASK_REGISTRY=/srv/fastwam/task-registry.json
FASTWAM_POLICY_TEXT_CACHE_DIR=/srv/fastwam/text-cache
